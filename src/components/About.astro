---
// About — editorial pull-quote spread
import { prospect } from '../prospect';

const currentYear = new Date().getFullYear();
---

<section class="about section" id="o-nama" aria-labelledby="o-nama-naslov">
  <div class="container">
    <div class="about__grid">
      <figure class="about__media" data-reveal>
        <div class="about__media-inner" data-parallax="0.06">
          <img
            src={prospect.doctorImage}
            alt={`${prospect.doctor.name} tokom rada u ordinaciji na ${prospect.address.district}u`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about__caption">
          <span class="about__caption-mark">↗</span>
          <span>{prospect.doctor.name}, ordinacija {prospect.address.district} — {currentYear}.</span>
        </figcaption>
      </figure>

      <div class="about__content">
        <p class="eyebrow" data-reveal>— {prospect.doctor.name}</p>

        <h2 id="o-nama-naslov" class="about__quote serif" data-reveal>
          „{prospect.doctor.quote}"
        </h2>

        <div class="about__body">
          {prospect.doctor.bioParas.map((para) => (
            <p data-reveal>{para}</p>
          ))}
        </div>

        <dl class="about__facts" data-reveal>
          <div class="fact">
            <dt class="fact__key">Specijalnost</dt>
            <dd class="fact__val">{prospect.doctor.specialty}</dd>
          </div>
          <div class="fact">
            <dt class="fact__key">Iskustvo</dt>
            <dd class="fact__val">{prospect.doctor.experience}</dd>
          </div>
          {prospect.team.length > 0 && (
            <div class="fact">
              <dt class="fact__key">Tim</dt>
              <dd class="fact__val">
                {prospect.team.map((member, i) => (
                  <>
                    {member.name} — {member.role}
                    {i < prospect.team.length - 1 && <br />}
                  </>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  // Light parallax for the about image — subtle ken-burns-ish drift on scroll
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion) {
    const targets = document.querySelectorAll<HTMLElement>('[data-parallax]');
    let lastY = window.scrollY;
    let raf = 0;

    function update() {
      const y = window.scrollY;
      targets.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) return;
        const strength = parseFloat(el.dataset.parallax || '0.05');
        const center = r.top + r.height / 2 - window.innerHeight / 2;
        el.style.setProperty('--py', `${-center * strength}px`);
      });
      raf = 0;
    }

    function onScroll() {
      if (raf) return;
      raf = requestAnimationFrame(update);
      lastY = window.scrollY;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .about {
    background: var(--bg-cream);
    color: var(--ink);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .about__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-deep);
    box-shadow: 0 30px 60px -30px rgba(15, 28, 42, 0.35);
  }

  .about__media-inner {
    position: absolute;
    inset: -10%;
    transform: translateY(var(--py, 0px));
    will-change: transform;
  }

  .about__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) contrast(1.04);
  }

  .about__media::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 35%;
    background: linear-gradient(180deg, transparent 0%, rgba(15, 28, 42, 0.65) 80%);
    pointer-events: none;
    z-index: 1;
  }

  .about__caption {
    position: absolute;
    bottom: 20px;
    left: 24px;
    right: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(241, 235, 221, 0.95);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .about__caption-mark {
    font-size: 14px;
    line-height: 1;
  }

  .about__content {
    padding-top: clamp(8px, 2vw, 32px);
  }

  .about__content .eyebrow {
    color: var(--ink-2);
    margin-bottom: 32px;
  }

  .about__quote {
    font-size: clamp(34px, 4.2vw, 64px);
    font-weight: 350;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 48px;
    max-width: 18ch;
  }

  .about__quote .serif--italic {
    color: var(--accent);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 50ch;
    margin-bottom: 48px;
  }

  .about__body p {
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .about__facts {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink-line);
  }

  .fact {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 32px;
    padding: 18px 0;
    border-bottom: 1px solid var(--ink-line);
    align-items: baseline;
  }

  .fact__key {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .fact__val {
    font-size: 15px;
    color: var(--ink);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .about__media { aspect-ratio: 16 / 11; max-width: 600px; }
  }

  @media (max-width: 720px) {
    .fact {
      grid-template-columns: 100px 1fr;
      gap: 20px;
    }
  }
</style>
