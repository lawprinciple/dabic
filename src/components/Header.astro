---
const navLinks = [
  { href: '#usluge', label: 'Usluge' },
  { href: '#o-nama', label: 'O nama' },
  { href: '#rezultati', label: 'Rezultati' },
  { href: '#kontakt', label: 'Kontakt' },
];
---

<header class="site-header" data-site-header aria-label="Glavna navigacija">
  <div class="site-header__inner">
    <nav class="site-header__nav" aria-label="Sekcije">
      <ul>
        {navLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="#kontakt" class="site-header__cta">
      <span>Zakažite pregled</span>
      <span class="site-header__cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    let raf = 0;
    function update() {
      const past = window.scrollY > window.innerHeight * 0.6;
      header!.classList.toggle('is-visible', past);
      raf = 0;
    }
    window.addEventListener(
      'scroll',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: clamp(12px, 1.6vw, 22px);
    left: 50%;
    transform: translate(-50%, -14px);
    z-index: 110;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.55s var(--ease),
      transform 0.55s var(--ease);
    width: max-content;
    max-width: calc(100vw - 24px);
    will-change: transform, opacity;
  }

  .site-header.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 14px;
    background: rgba(250, 250, 247, 0.72);
    -webkit-backdrop-filter: saturate(140%) blur(18px);
    backdrop-filter: saturate(140%) blur(18px);
    border: 1px solid rgba(216, 208, 192, 0.7);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 18px 40px -22px rgba(15, 28, 42, 0.25),
      0 2px 8px -2px rgba(15, 28, 42, 0.08);
  }

  /* Nav */
  .site-header__nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    padding: 9px 14px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--ink-2);
    border-radius: 999px;
    transition: color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .site-header__nav a:hover {
    color: var(--ink);
    background: rgba(15, 28, 42, 0.06);
  }

  /* CTA */
  .site-header__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--ink);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.005em;
    border-radius: 999px;
    transition: background-color 0.45s var(--ease);
    white-space: nowrap;
  }

  .site-header__cta:hover {
    background: var(--accent);
  }

  .site-header__cta-arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease);
    font-size: 13px;
  }

  .site-header__cta:hover .site-header__cta-arrow {
    transform: translateX(3px);
  }

  /* Fallback if backdrop-filter isn't supported */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header__inner {
      background: rgba(250, 250, 247, 0.96);
    }
  }

  /* Mobile — drop nav links, keep only the CTA pill */
  @media (max-width: 720px) {
    .site-header {
      top: 10px;
    }
    .site-header__inner {
      padding: 4px 4px 4px 4px;
      gap: 0;
    }
    .site-header__nav {
      display: none;
    }
    .site-header__cta {
      padding: 11px 18px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: opacity 0.2s linear;
      transform: translate(-50%, 0);
    }
    .site-header.is-visible {
      transform: translate(-50%, 0);
    }
  }
</style>
