---
import { prospect } from '../prospect';

const items = [
  { big: `${prospect.yearsExperience}+`, label: 'godina iskustva' },
  { big: `${prospect.patientCount}+`, label: 'pacijenata' },
  { big: prospect.address.district, label: prospect.address.city },
  { big: 'Komora', label: 'Stomatološka komora Srbije' },
];
// Duplicate for seamless marquee
const loop = [...items, ...items, ...items];
---

<section class="trust" aria-label="Ključni podaci o ordinaciji">
  <div class="trust__marquee">
    <div class="trust__track">
      {loop.map((item) => (
        <div class="trust__item">
          <span class="trust__big serif serif--italic">{item.big}</span>
          <span class="trust__label">{item.label}</span>
          <span class="trust__sep" aria-hidden="true">✦</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--bg);
    border-top: 1px solid var(--ink-line);
    border-bottom: 1px solid var(--ink-line);
    padding: 32px 0;
    overflow: hidden;
    color: var(--ink);
  }

  .trust__marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .trust__track {
    display: flex;
    align-items: center;
    gap: 0;
    width: max-content;
    animation: marquee 42s linear infinite;
    will-change: transform;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-100% / 3)); }
  }

  .trust__item {
    display: inline-flex;
    align-items: baseline;
    gap: 16px;
    padding: 0 28px;
    white-space: nowrap;
  }

  .trust__big {
    font-size: clamp(34px, 4.4vw, 56px);
    font-weight: 400;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 144, 'SOFT' 30, 'slnt' -10;
  }

  .trust__label {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }

  .trust__sep {
    font-size: 14px;
    color: var(--ink-3);
  }
</style>
